<Window x:Class="CSVReaderTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSVReaderTool"
        xmlns:Converter="clr-namespace:CSVReaderTool.Logik"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="500" MinWidth="700" Height="650" Width="1000">
    <Window.Resources>
        <Converter:HttpColor x:Key="HttpColor"/>
    </Window.Resources>
    
    <Grid Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition />
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="1" Margin="35,0,35,30" ItemsSource="{Binding TableView}" AutoGenerateColumns="True" AutoGeneratingColumn="dataGrid_AutoGeneratingColumn"/>

        <Grid Background="Gray" Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto" MaxWidth="160"/>
                <ColumnDefinition Width="auto" MaxWidth="160"/>

            </Grid.ColumnDefinitions>

            <Button Margin="10" Width="140" Content="Datei auswählen" Command="{Binding DateiAuswaehlenCommand}"/>
            <Label Grid.Column="1" Margin="0,20,10,15" Content="{Binding DateiName}" Width="auto" FontSize="15" />
            <Button Grid.Column="3"  Margin="10" Width="140" Content="Einlesen" Command="{Binding DateiAuslesenCommand}" />
            <Button Grid.Column="4" Margin="10" Width="140" Content="Exportieren" IsEnabled="{Binding Enabled}" Command="{Binding DateiExportCommand}"/>

        </Grid>
        <Grid Grid.RowSpan="3" Visibility="{Binding Loading}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Rectangle Fill="Gray" Opacity="0.5" Grid.ColumnSpan="3" Grid.RowSpan="4"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Rectangle.Loaded">
                        <BeginStoryboard>
                            <Storyboard Name="waitingAnimation" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Dot1" BeginTime="0:0:0.1" Storyboard.TargetProperty="Opacity" From=".1" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                                <DoubleAnimation Storyboard.TargetName="Dot2" BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity" From=".1" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                                <DoubleAnimation Storyboard.TargetName="Dot3" BeginTime="0:0:0.3" Storyboard.TargetProperty="Opacity" From=".1" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                <Ellipse Name="Dot1" Fill="Black" Opacity=".1" Width="8" Height="8"/>
                <Ellipse Name="Dot2" Fill="Black" Opacity=".1" Width="8" Height="8" Margin="2,0,0,0"/>
                <Ellipse Name="Dot3" Fill="Black" Opacity=".1" Width="8" Height="8" Margin="2,0,0,0"/>
            </StackPanel>

            <Button Content="Abbrechen" Grid.Column="1" Grid.Row="2" Margin="10,25,10,10" MinHeight="40" MinWidth="100" Command="{Binding AbbrechenCommand}"/>
        </Grid>
        
    </Grid>
</Window>
